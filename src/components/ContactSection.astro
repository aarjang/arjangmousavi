---
interface Props {
  content: {
    heading: string;
    intro: string;
    linkedinLabel: string;
    emailLabel: string;
    email: string;
    emailNote: string;
    calendlyLabel: string;
    calendly: string;
    copyLink: string;
    copyEmail: string;
    copiedLabel: string;
    formTitle: string;
    formNote: string;
    formName: string;
    formEmail: string;
    formMessage: string;
    formSubmit: string;
  };
  linkedin: string;
}

const { content, linkedin } = Astro.props;
const formAction = `https://formsubmit.co/${encodeURIComponent(content.email)}`;
---

<div class="grid gap-6 lg:grid-cols-2">
  <article class="section-card reveal p-6">
    <p class="mb-6 text-muted/90">{content.intro}</p>
    <div class="space-y-4">
      <div class="rounded-xl border border-accent/25 p-4">
        <p class="text-xs uppercase tracking-[0.15em] text-accent/90">{content.linkedinLabel}</p>
        <a href={linkedin} target="_blank" rel="noreferrer" class="mt-2 inline-flex text-white hover:text-accent">{linkedin}</a>
      </div>
      <div class="rounded-xl border border-accent/25 p-4">
        <p class="text-xs uppercase tracking-[0.15em] text-accent/90">{content.emailLabel}</p>
        <p class="mt-2 text-white">{content.email}</p>
        <p class="mt-1 text-xs text-muted/80">{content.emailNote}</p>
      </div>
      <div class="rounded-xl border border-accent/25 p-4">
        <p class="text-xs uppercase tracking-[0.15em] text-accent/90">{content.calendlyLabel}</p>
        <a href={content.calendly} target="_blank" rel="noreferrer" class="mt-2 inline-flex text-white hover:text-accent">{content.calendly}</a>
      </div>
    </div>
    <div class="mt-6 flex flex-wrap gap-3">
      <button type="button" class="copy-btn rounded-full border border-accent/50 px-4 py-2 text-xs font-semibold text-accent" data-copy={linkedin} data-copied={content.copiedLabel}>{content.copyLink}</button>
      <button type="button" class="copy-btn rounded-full border border-accent/50 px-4 py-2 text-xs font-semibold text-accent" data-copy={content.email} data-copied={content.copiedLabel}>{content.copyEmail}</button>
    </div>
  </article>

  <article class="section-card reveal p-6">
    <h3 class="mb-4 font-heading text-2xl text-white">{content.formTitle}</h3>
    <p class="mb-4 text-sm text-muted/85">{content.formNote}</p>
    <form
      id="contact-form"
      class="space-y-4"
      method="POST"
      action={formAction}
    >
      <input type="hidden" name="_subject" value="New website contact request" />
      <input type="hidden" name="_captcha" value="true" />
      <input type="hidden" name="_template" value="table" />
      <input type="text" name="_honey" class="hidden" tabindex="-1" autocomplete="off" />

      <label class="block text-sm text-muted" for="name">{content.formName}</label>
      <input id="name" name="name" required class="w-full rounded-xl border border-accent/30 bg-bg/40 px-4 py-2 text-white placeholder:text-muted/60" />

      <label class="block text-sm text-muted" for="email">{content.formEmail}</label>
      <input id="email" name="email" type="email" required class="w-full rounded-xl border border-accent/30 bg-bg/40 px-4 py-2 text-white placeholder:text-muted/60" />

      <label class="block text-sm text-muted" for="message">{content.formMessage}</label>
      <textarea id="message" name="message" rows="4" required class="w-full rounded-xl border border-accent/30 bg-bg/40 px-4 py-2 text-white placeholder:text-muted/60"></textarea>

      <button type="submit" class="rounded-full bg-accent px-6 py-2 text-sm font-semibold text-bg transition hover:bg-accentStrong">{content.formSubmit}</button>
    </form>
  </article>
</div>
