---
interface Props {
  name: string;
  title: string;
  tagline: string;
  location: string;
  ctaPrimary: string;
  ctaSecondary: string;
  stats: string[];
}

const { name, title, tagline, location, ctaPrimary, ctaSecondary, stats } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
---

<section id="top" class="mx-auto max-w-6xl px-6 pb-20 pt-16 lg:px-8 lg:pt-24">
  <div class="hero-frame reveal px-8 py-14 shadow-premium lg:px-12">
    <div class="hero-grid items-center gap-10">
      <div>
        <div class="mb-8 inline-flex items-center gap-3 rounded-full border border-accent/40 bg-bg/30 px-5 py-2 text-[11px] uppercase tracking-[0.2em] text-accent">
          <span class="h-1.5 w-1.5 rounded-full bg-accent"></span>
          {location}
        </div>
        <h1 class="font-heading text-4xl leading-tight text-white sm:text-5xl lg:text-6xl">{name}</h1>
        <p class="mt-4 text-lg text-muted sm:text-xl">{title}</p>
        <div class="mt-5 h-px w-28 bg-gradient-to-r from-accent via-accentStrong to-transparent"></div>
        <p class="mt-5 max-w-2xl text-xl font-medium leading-relaxed text-accent">{tagline}</p>
        <div class="mt-9 flex flex-wrap gap-4">
          <a href="#contact" class="rounded-full bg-accent px-6 py-3 text-sm font-semibold text-bg transition hover:bg-accentStrong">{ctaPrimary}</a>
          <a href="#work" class="rounded-full border border-accent/50 px-6 py-3 text-sm font-semibold text-accent transition hover:bg-accent/10">{ctaSecondary}</a>
        </div>
        <div class="mt-11 grid gap-3 sm:grid-cols-3">
          {stats.map((stat) => (
            <div class="luxury-pill p-4 text-center text-[12px] font-semibold uppercase tracking-[0.16em] text-white/90">{stat}</div>
          ))}
        </div>
      </div>

      <aside class="portrait-shell mx-auto w-full max-w-sm">
        <div class="portrait-frame">
          <img
            src={`${base}images/arjang-portrait.svg`}
            alt={name}
            width="900"
            height="1100"
            loading="eager"
            decoding="async"
            class="portrait-image"
          />
        </div>
      </aside>
    </div>
  </div>
</section>
