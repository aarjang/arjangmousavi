---
interface Props {
  id: string;
  title: string;
  className?: string;
}

const { id, title, className = '' } = Astro.props;
---

<section id={id} class={`mx-auto max-w-6xl px-6 py-10 lg:px-8 lg:py-14 ${className}`}>
  <div class="mb-8 reveal">
    <h2 class="font-heading text-3xl text-white sm:text-4xl">{title}</h2>
    <div class="mt-3 h-px w-20 bg-accent/70"></div>
  </div>
  <slot />
</section>
