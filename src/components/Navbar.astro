---
interface Props {
  name: string;
  nav: {
    about: string;
    services: string;
    work: string;
    experience: string;
    collaborations: string;
    contact: string;
  };
  switcher: {
    label: string;
    href: string;
    aria: string;
  };
  linkedin: string;
}

const { name, nav, switcher, linkedin } = Astro.props;
const base = import.meta.env.BASE_URL || '/';
const navLinks = [
  { id: 'about', label: nav.about },
  { id: 'services', label: nav.services },
  { id: 'work', label: nav.work },
  { id: 'experience', label: nav.experience },
  { id: 'collaborations', label: nav.collaborations },
  { id: 'contact', label: nav.contact }
];
---

<header class="sticky top-0 z-50 border-b border-accent/20 bg-bg/85 backdrop-blur">
  <nav class="mx-auto flex max-w-6xl flex-wrap items-center justify-between gap-3 px-6 py-4 lg:px-8" aria-label="Main navigation">
    <a href="#top" class="font-heading text-lg text-accent hover:text-accentStrong transition-colors">{name}</a>
    <div class="flex max-w-full items-center gap-4 overflow-x-auto">
      {navLinks.map((link) => (
        <a href={`#${link.id}`} class="text-sm text-muted hover:text-accent transition-colors">{link.label}</a>
      ))}
      <a
        href={`${base}${switcher.href.replace(/^\//, '')}`}
        lang={switcher.label === 'FA' ? 'fa' : 'en'}
        class="rounded-full border border-accent/45 px-3 py-1.5 text-xs font-semibold uppercase tracking-wider text-accent hover:bg-accent hover:text-bg transition-colors"
        aria-label={switcher.aria}
      >
        {switcher.label}
      </a>
      <a
        href={linkedin}
        target="_blank"
        rel="noreferrer"
        aria-label="LinkedIn"
        class="inline-flex h-9 w-9 items-center justify-center rounded-full border border-accent/45 text-accent transition-colors hover:bg-accent hover:text-bg"
      >
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4 fill-current">
          <path d="M4.98 3.5c0 1.38-1.11 2.5-2.48 2.5C1.12 6 0 4.88 0 3.5 0 2.12 1.12 1 2.5 1s2.48 1.12 2.48 2.5zM0.5 8.2h4v12.3h-4V8.2zm7.5 0h3.8v1.7h.1c.5-.9 1.7-1.9 3.6-1.9 3.9 0 4.6 2.6 4.6 6v6.5h-4v-5.8c0-1.4 0-3.2-2-3.2s-2.3 1.5-2.3 3.1v5.9h-4V8.2z"/>
        </svg>
      </a>
    </div>
  </nav>
</header>
