---
import '../styles.css';

interface Props {
  lang: 'en' | 'fa';
  dir: 'ltr' | 'rtl';
  title: string;
  description: string;
  ogTitle: string;
  ogDescription: string;
  skipToContent: string;
}

const { lang, dir, title, description, ogTitle, ogDescription, skipToContent } = Astro.props;

const base = import.meta.env.BASE_URL || '/';
const cleanBase = base.endsWith('/') ? base.slice(0, -1) : base;
const siteUrl = import.meta.env.SITE || 'https://username.github.io';
const enPath = cleanBase ? `${cleanBase}/` : '/';
const faPath = cleanBase ? `${cleanBase}/fa/` : '/fa/';
const pageUrl = new URL(Astro.url.pathname, siteUrl).toString();
const ogImage = new URL(`${cleanBase || ''}/og-image.svg`, siteUrl).toString();

const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: lang === 'en' ? 'Arjang Mousavi' : 'ارژنگ موسوی',
  jobTitle: lang === 'en' ? 'Product Lead • Product Consultant • Product Creator' : 'پروداکت لید • مشاور محصول • سازنده محصول',
  url: pageUrl,
  sameAs: ['https://www.linkedin.com/in/arjang-mousavi/'],
  description
};
---

<!doctype html>
<html lang={lang} dir={dir}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={pageUrl} />
    <meta property="og:image" content={ogImage} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    <meta name="twitter:image" content={ogImage} />
    <link rel="icon" href={`${base}favicon.svg`} type="image/svg+xml" />
    <link rel="alternate" hreflang="en" href={new URL(enPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="fa" href={new URL(faPath, siteUrl).toString()} />
    <link rel="alternate" hreflang="x-default" href={new URL(enPath, siteUrl).toString()} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)}></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">{skipToContent}</a>
    <slot />
    <script src={`${base}scripts/main.js`} defer></script>
  </body>
</html>
